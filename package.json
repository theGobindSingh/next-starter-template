{
  "name": "next-starter-template",
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Gobind Singh",
    "email": "thesinghgobind@gmail.com",
    "url": "https://github.com/theGobindSingh/"
  },
  "private": true,
  "scripts": {
    "prepare": "node scripts/link-agents.js",
    "prebuild": "pnpm run lint:fix",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "lint": "prettier --config .prettierrc \"src/**/*.{ts,js,tsx,jsx}\" --check && eslint \"src/**/*.{ts,js,tsx,jsx}\"",
    "lint:fix": "prettier --config .prettierrc \"src/**/*.{ts,js,tsx,jsx}\" --write && eslint \"src/**/*.{ts,js,tsx,jsx}\" --fix",
    "browser:install": "playwright-mcp install-browser chromium"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "graphql": "^16.14.2",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "payload": "^3.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webadeva/eslint-config": "^0.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "description": "A lean, batteries-included Next.js starter with TypeScript, Tailwind CSS v4, Payload CMS and strict linting."
}
