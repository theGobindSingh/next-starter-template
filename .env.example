# Copy to .env and fill in. Never commit .env.

# Public URL of the site, used for canonical, sitemap and social URLs.
SITE_URL=https://example.com

# Extra origin allowed to reach the dev server (e.g. a LAN IP or tunnel).
DEV_SERVER_ORIGIN=

# Payload. Generate a secret with: openssl rand -hex 32
PAYLOAD_SECRET=
# SQLite file by default; any libSQL URL works.
DATABASE_URL=file:./payload.db
